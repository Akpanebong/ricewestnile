# Copy this file to .env and fill in real values. .env is gitignored and
# read automatically on startup (see enterprise/settings.py).
#
# Local development: setting DJANGO_DEBUG=True is enough — a dev-only
# SECRET_KEY and permissive ALLOWED_HOSTS are supplied automatically.
#
# Any other environment (staging, production, anything reachable by someone
# other than you): all three of the following are required. The app will
# refuse to start without SECRET_KEY when DEBUG is not True.

DJANGO_DEBUG=False

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Comma-separated list of hostnames this deployment is served from.
DJANGO_ALLOWED_HOSTS=example.org,www.example.org

# Optional overrides — see enterprise/settings.py for the full list and
# current defaults (SQLite / console-based email / etc.).
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=
