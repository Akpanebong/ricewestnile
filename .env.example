# DB_NAME=your_pythonanywhere_database_name
# DB_USER=your_pythonanywhere_username
# DB_PASSWORD=your_database_password
# DB_HOST=your_pythonanywhere_username.postgres.pythonanywhere-services.com
# DB_PORT=10100
